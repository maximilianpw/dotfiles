{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#3ea6ff",
    "pink": "#fe90c9",
    "white": "#ffffff"
  },
  "secondary_prompt": {
    "template": "❯❯ ",
    "foreground": "p:pink",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "❯ ",
    "foreground": "",
    "background": "transparent",
    "foreground_templates": [
      "{{ if gt .Code 0 }}#FF5252{{ end }}",
      "{{ if eq .Code 0 }}p:pink{{ end }}"
    ]
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "style": "plain",
          "template": " \uf0e7 ",
          "foreground": "p:blue",
          "background": "",
          "type": "root"
        },
        {
          "properties": {
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "foreground": "p:blue",
          "background": "",
          "type": "path"
        },
        {
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          },
          "style": "plain",
          "template": "<#26C6DA>❯ </>{{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}*{{ end }} ",
          "foreground": "p:pink",
          "background": "",
          "type": "git"
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "properties": {
            "style": "round",
            "threshold": 5000
          },
          "style": "plain",
          "template": " {{ .FormattedMs }}",
          "foreground": "#fdb900",
          "background": "transparent",
          "type": "executiontime"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "precision": 2
          },
          "style": "powerline",
          "template": "<p:white>\ue266</> RAM: {{ (div ((sub .PhysicalAvailableMemory 0)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB ",
          "foreground": "p:white",
          "background": "transparent",
          "type": "sysinfo"
        },
        {
          "properties": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": "| {{ .CurrentDate | date .Format }}",
          "foreground": "p:white",
          "background": "",
          "type": "time"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " ❯ ",
          "foreground": "p:pink",
          "background": "",
          "type": "status",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5252{{ end }}",
            "{{ if eq .Code 0 }}p:pink{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
