{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "closer": "p:os",
    "pink": "#F5BDE6",
    "lavender": "#B7BDF8",
    "blue": "#8AADF4"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:pink",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "mapped_locations_enabled": true,
            "mapped_locations": {
              "/Users/max-vev/Documents/Vev Platform Services/vev-docker-compose/submodules/": "vev-docker",
              "~/Documents/dotfiles/": "dotfiles",
              "~/Documents/ynov/project-docker-compose/": "projet-ynov"
            }
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:lavender",
          "properties": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "{{ .HEAD }} ",
          "style": "plain",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "sysinfo",
          "powerline_symbol": "",
          "foreground": "p:os",
          "background": "transparent",
          "template": "  {{ round .PhysicalPercentUsed .Precision }}% |",
          "properties": {
            "precision": 2
          },
          "style": "powerline"
        },
        {
          "background": "transparent",
          "foreground": "p:os",
          "invert_powerline": true,
          "trailing_diamond": "",
          "style": "diamond",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:closer",
          "foreground_templates": ["{{ if gt .Code 0 }}#ef5350{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " \uf105",
          "type": "status"
        }
      ],
      "newline": true,
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
