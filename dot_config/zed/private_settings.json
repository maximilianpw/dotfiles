{
  // Telemetry & Base Settings
  "edit_predictions": {
    "provider": "zed"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "Material Icon Theme",
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  // Font Settings
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  // Theme — Everforest Dark Hard, fixed dark to match nvim
  "theme": {
    "mode": "dark",
    "light": "Everforest Light Hard (material)",
    "dark": "Everforest Dark Hard (material)"
  },
  // Editor Settings
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 10,
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "show_whitespaces": "trailing",
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "confirm_quit": true,
  "always_treat_brackets_as_autoclosed": true,
  "autosave": "off",
  "scroll_beyond_last_line": "off",
  "cursor_blink": false,
  "linked_edits": true,
  "minimap": {
    "show": "never"
  },
  // Search Settings
  "search": {
    "case_sensitive": false,
    "whole_word": false,
    "regex": false
  },
  // Terminal Settings
  "terminal": {
    "copy_on_select": true,
    "blinking": "off",
    "alternate_scroll": "on",
    "option_as_meta": true,
    "shell": {
      "program": "/bin/zsh"
    },
    "font_size": 14,
    "line_height": "comfortable"
  },
  // Project Panel
  "project_panel": {
    "button": true,
    "default_width": 280,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": "never"
    }
  },
  // Outline Panel
  "outline_panel": {
    "dock": "right",
    "default_width": 300
  },
  // Collaboration Panel
  "collaboration_panel": {
    "dock": "left",
    "default_width": 240
  },
  // Git Integration
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500
    }
  },
  // Inlay Hints - consistent: parameter hints only
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": false,
    "edit_debounce_ms": 200,
    "scroll_debounce_ms": 50
  },
  // LSP Configuration
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "cargo": {
          "allFeatures": true
        },
        "procMacro": {
          "enable": true
        }
      }
    },
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": false,
          "compositeLiteralFields": false,
          "compositeLiteralTypes": false,
          "constantValues": true,
          "functionTypeParameters": false,
          "parameterNames": true,
          "rangeVariableTypes": false
        },
        "usePlaceholders": false,
        "completeUnimported": true,
        "staticcheck": true,
        "gofumpt": true
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "literals",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": false,
          "includeInlayFunctionParameterTypeHints": false,
          "includeInlayVariableTypeHints": false,
          "includeInlayPropertyDeclarationTypeHints": false,
          "includeInlayFunctionLikeReturnTypeHints": false,
          "includeInlayEnumMemberValueHints": false
        }
      }
    },
    "eslint": {
      "settings": {
        "workingDirectories": {
          "mode": "auto"
        }
      }
    }
  },
  // Languages Configuration —
  // Prettier-eligible languages use "language_server" as their formatter; Zed's
  // built-in prettier integration runs in addition when the project has a prettier
  // config (default: prettier.allowed = true), otherwise the LSP formats. Mirrors
  // nvim autoformat.lua's "prettier-when-config-exists, else LSP" behavior.
  "languages": {
    "TypeScript": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": false
      }
    },
    "TSX": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": false
      }
    },
    "JavaScript": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": false
      }
    },
    "JSON": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on"
    },
    "JSONC": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on"
    },
    "HTML": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on"
    },
    "CSS": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on"
    },
    "YAML": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": "language_server",
      "tab_size": 2,
      "format_on_save": "on",
      "soft_wrap": "editor_width"
    },
    "Go": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true,
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "Rust": {
      "formatter": "language_server",
      "tab_size": 4,
      "format_on_save": "on"
    },
    "Python": {
      "formatter": [
        {
          "external": {
            "command": "ruff",
            "arguments": [
              "format",
              "-"
            ]
          }
        },
        {
          "external": {
            "command": "black",
            "arguments": [
              "-"
            ]
          }
        }
      ],
      "tab_size": 4,
      "format_on_save": "on"
    },
    "C": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": [
            "--assume-filename={buffer_path}"
          ]
        }
      },
      "tab_size": 2,
      "format_on_save": "on"
    },
    "C++": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": [
            "--assume-filename={buffer_path}"
          ]
        }
      },
      "tab_size": 2,
      "format_on_save": "on"
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": [
            "-i",
            "2",
            "-"
          ]
        }
      },
      "tab_size": 2,
      "format_on_save": "on"
    },
    "TOML": {
      "formatter": {
        "external": {
          "command": "taplo",
          "arguments": [
            "fmt",
            "-"
          ]
        }
      },
      "format_on_save": "on"
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "-"
          ]
        }
      },
      "format_on_save": "on"
    },
    "Nix": {
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": [
            "-q"
          ]
        }
      },
      "format_on_save": "on"
    }
  },
  // File Finder Settings
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/bower_components",
    "**/vendor",
    "**/.venv",
    "**/venv",
    "**/.direnv",
    "**/__pycache__",
    "**/*.pyc",
    "**/target",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.nuxt",
    "**/.cache",
    "**/.idea",
    "**/.vscode",
    "**/.turbo",
    "**/.vercel",
    "**/.output",
    "**/coverage",
    "**/.nyc_output",
    "**/tmp",
    "**/.tmp"
  ],
  // Vim Mode Settings
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true
  },
  // Assistant Settings
  "agent": {
    "enabled": true,
    "button": true,
    "default_width": 640,
    "default_height": 480,
    "dock": "right"
  },
  // Diagnostics
  "diagnostics": {
    "include_warnings": true
  },
  // Preview Tabs - disabled (less surprising behavior)
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": false,
    "enable_keep_preview_on_code_navigation": false
  },
  // Tabs
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },
  // Toolbar
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true
  },
  // Journal
  "journal": {
    "path": "~",
    "hour_format": "hour24"
  },
  // Calls
  "calls": {
    "mute_on_join": true,
    "share_on_join": false
  },
  // Collaboration
  "show_call_status_icon": true,
  // Inline Completion
  "show_edit_predictions": true,
  // UI Settings
  "show_wrap_guides": true,
  "wrap_guides": [
    80,
    120
  ],
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },
  // Hover Popover
  "hover_popover_enabled": true,
  // Multi-cursor Settings
  "multi_cursor_modifier": "alt",
  // Seed Search Query From Cursor
  "seed_search_query_from_cursor": "selection",
  // Current Line Highlight
  "current_line_highlight": "gutter",
  // Scrollbar
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_symbol": true,
    "diagnostics": "all"
  },
  // File Types (associate extensions with languages)
  "file_types": {
    "Dockerfile": [
      "Dockerfile*",
      "*.dockerfile"
    ],
    "Shell Script": [
      ".envrc",
      ".env.example"
    ]
  },
  // Centered Layout
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15
  },
  // Gutter
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "folds": true
  }
}
