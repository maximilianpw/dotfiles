.claude/*
CLAUDE.md
AGENTS.md

# ~/Library is macOS-only. Ignore the whole tree elsewhere so chezmoi does not
# create empty Library/Application Support directories on Linux or Windows.
{{ if ne .chezmoi.os "darwin" }}
Library/
{{ end }}

# Local-only LLM review prompt and generated review artifacts
LLM_CONFIG_REVIEW_PROMPT.md
.review-plans/*
.github
.config/zed/conversations
.config/zed/themes
.config/zed/prompts
.config/zed/settings_backup.json
# Local-only: contains employer AWS account details; repo is public
.aws
# Machine-rewritten by btop itself; managing it is permanent diff noise
.config/btop
# Amp settings belong to Nix/Home Manager; backups and write metadata stay local.
.config/amp/settings.json
.config/amp/settings.json.*

# Nixvim, Hjem and Home Manager own these paths on migrated fleet hosts.
# Keep unmanaged siblings (application state, credentials) out of this handoff.
{{/* chezmoi's DNS-derived hostname can be 127-0-0-1 on NixOS. */}}
{{ $fleetHost := output "hostname" | trim | lower | trimSuffix ".local" }}
{{ if or (eq $fleetHost "kim") (eq $fleetHost "cuno") (eq $fleetHost "joyce") }}
